{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deep:braid-recovery:v2:vectors",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "decision", "scope", "positive", "negative"],
  "properties": {
    "$schema": { "const": "braid-recovery-v2.vectors.schema.json" },
    "decision": { "const": "DR-0111" },
    "scope": { "const": "structural-only; synthetic public bytes and unverified MAC, not native crypto or authenticated recovery evidence" },
    "positive": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "payloadBytes", "encodedHex"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": [1, 3, 5, 6] },
          "payloadBytes": { "enum": [96, 1152, 960, 160] },
          "encodedHex": { "type": "string", "pattern": "^[0-9A-F]{8224}$" }
        }
      }
    },
    "negative": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "mutation", "rejection"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mutation": { "type": "string", "minLength": 1 },
          "rejection": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
