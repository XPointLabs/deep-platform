{
  "$schema": "braid-recovery-v2.vectors.schema.json",
  "decision": "DR-0111",
  "scope": "structural-only; synthetic public bytes and unverified MAC, not native crypto or authenticated recovery evidence",
  "positive": [
    {
      "name": "Header",
      "kind": 1,
      "payloadBytes": 96,
      "encodedHex": ""
    },
    {
      "name": "EncapsulationKeyWithCiphertext1Ack",
      "kind": 3,
      "payloadBytes": 1152,
      "encodedHex": ""
    },
    {
      "name": "Ciphertext1",
      "kind": 5,
      "payloadBytes": 960,
      "encodedHex": ""
    },
    {
      "name": "Ciphertext2",
      "kind": 6,
      "payloadBytes": 160,
      "encodedHex": ""
    }
  ],
  "negative": [
    {
      "name": "short",
      "mutation": "remove final byte",
      "rejection": "InvalidTotalSize"
    },
    {
      "name": "trailing",
      "mutation": "append zero byte",
      "rejection": "InvalidTotalSize"
    },
    {
      "name": "magic",
      "mutation": "change byte0",
      "rejection": "WrongMagic"
    },
    {
      "name": "version",
      "mutation": "set version2",
      "rejection": "WrongVersion"
    },
    {
      "name": "suite",
      "mutation": "set suite0x0202",
      "rejection": "WrongSuite"
    },
    {
      "name": "fields",
      "mutation": "set fieldCount10",
      "rejection": "WrongFieldCount"
    },
    {
      "name": "reserved",
      "mutation": "set header reserved1",
      "rejection": "ReservedNotZero"
    },
    {
      "name": "duplicate",
      "mutation": "set tag2=1",
      "rejection": "DuplicateTag"
    },
    {
      "name": "unknown",
      "mutation": "set tag11=12",
      "rejection": "UnknownTag"
    },
    {
      "name": "length",
      "mutation": "set tag9 length=u32max",
      "rejection": "InvalidFieldLength"
    },
    {
      "name": "zero-network",
      "mutation": "zero tag1",
      "rejection": "ZeroForbidden"
    },
    {
      "name": "reflected",
      "mutation": "copy tag3 to tag4",
      "rejection": "CrossFieldMismatch"
    },
    {
      "name": "zero-epoch",
      "mutation": "zero tag6",
      "rejection": "InvalidCounter"
    },
    {
      "name": "wrapped-epoch",
      "mutation": "set tag6=u64max",
      "rejection": "InvalidCounter"
    },
    {
      "name": "zero-counter",
      "mutation": "set tag7=0",
      "rejection": "InvalidCounter"
    },
    {
      "name": "third-counter",
      "mutation": "set tag7=3",
      "rejection": "InvalidCounter"
    },
    {
      "name": "none",
      "mutation": "set tag8=0",
      "rejection": "InvalidEnum"
    },
    {
      "name": "partial-ek",
      "mutation": "set tag8=2",
      "rejection": "InvalidEnum"
    },
    {
      "name": "bare-ack",
      "mutation": "set tag8=4",
      "rejection": "InvalidEnum"
    },
    {
      "name": "unknown-kind",
      "mutation": "set tag8=255",
      "rejection": "InvalidEnum"
    },
    {
      "name": "kind-size",
      "mutation": "set Header tag8=5",
      "rejection": "CrossFieldMismatch"
    },
    {
      "name": "padding",
      "mutation": "set first padding byte1",
      "rejection": "ReservedNotZero"
    }
  ]
}
