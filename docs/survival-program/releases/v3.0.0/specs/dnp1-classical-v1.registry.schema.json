    "protocolEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "deep-protocol" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "registryEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "deep-registry-api" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "xnodeEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "xnode" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "sharedEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "deep-client-shared" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "devopsEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "deep-devops" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "e2eEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "deep-tests-e2e" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "mauiEvidenceRepository": { "type": "object", "additionalProperties": false, "required": ["repository", "expectedRevision"], "properties": { "repository": { "const": "deep-client-maui" }, "expectedRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" } } },
    "recordClass": { "type": "object", "additionalProperties": false, "required": ["headerSuite", "records"], "properties": { "headerSuite": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 }, "records": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9]{4}$" } } } },
    "artifactType": {
      "type": "object",
