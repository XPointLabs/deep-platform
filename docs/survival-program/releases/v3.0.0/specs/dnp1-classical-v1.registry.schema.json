          }
        },
        "currentClaim": { "enum": ["ClassificationOnly", "ProtocolPackageGO", "CutoverFinalReleaseGO"] },
        "evidenceManifestPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^docs/survival-program/releases/v3\\.0\\.0/evidence/dnp1/[a-z0-9.-]+\\.json$" } },
        "machineBinding": { "type": "string", "minLength": 128 },
