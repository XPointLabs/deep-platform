        "evidenceManifestSchemaPath": { "const": "docs/survival-program/releases/v3.0.0/specs/dnp1-classical-v1.evidence-manifest.schema.json" },
        "evidenceAttestationSchemaPath": { "const": "docs/survival-program/releases/v3.0.0/specs/dnp1-classical-v1.evidence-attestation.schema.json" },
        "owners": { "const": ["Protocol", "Registry", "XNode", "Shared", "DevOpsWitness", "CrossRepoE2E", "MAUI"] },
        "gates": { "const": ["ProtocolPackageBlocking", "CutoverFinalRelease"] },
        "ownerCounts": { "const": { "Protocol": 171, "Registry": 15, "XNode": 11, "Shared": 2, "DevOpsWitness": 12, "CrossRepoE2E": 27, "MAUI": 3 } },
        "gateCounts": { "const": { "ProtocolPackageBlocking": 174, "CutoverFinalRelease": 67 } },
        "allowedMatrix": { "const": { "ProtocolPackageBlocking": ["Protocol", "DevOpsWitness"], "CutoverFinalRelease": ["Registry", "XNode", "Shared", "DevOpsWitness", "CrossRepoE2E", "MAUI"] } },
        "protocolPackageRule": { "type": "string", "minLength": 128 },
        "cutoverFinalRule": { "type": "string", "minLength": 128 },
        "repositoryBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Protocol", "Registry", "XNode", "Shared", "DevOpsWitness", "CrossRepoE2E", "MAUI"],
