{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deep:dnp1:classical:v1:evidence-ownership",
  "title": "DNP1 executable evidence ownership",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "decision", "workPackage", "normativeCommit", "normativeVectorSkeletonSha256", "sourceSnapshot", "sourceAudit", "ownerEnum", "gateEnum", "rows"],
  "properties": {
    "$schema": { "const": "dnp1-classical-v1.evidence-ownership.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "status": { "const": "normative-executable-evidence-ownership" },
    "decision": { "const": "DR-0003" },
    "workPackage": { "const": "DNP1-PROTO-classical-identity-reset-routing" },
    "normativeCommit": { "const": "7390d0996dd8ec9c6d8953ed55d299e7f2e90ddb" },
    "normativeVectorSkeletonSha256": { "const": "449c84b2bfd754e44da11fcd69aa4d3917db95a2a410168cabc98d6d57959b25" },
    "sourceSnapshot": {
      "const": {
        "path": "docs/survival-program/releases/v3.0.0/specs/dnp1-classical-v1.evidence-source-snapshot.json",
        "originPath": "deep-protocol/artifacts/dnp1-vector-fragments/all146-classification.json",
        "sha256": "64066a8081777736f4e697b6c9fe58c81e9c4be9af65866362b5c2471e7bed43"
      }
    },
    "sourceAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRowCount", "addedIds", "overriddenIds"],
      "properties": {
        "sourceRowCount": { "const": 146 },
        "addedIds": { "type": "array", "minItems": 168, "maxItems": 168, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "overriddenIds": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    },
    "ownerEnum": { "const": ["Protocol", "Registry", "XNode", "Shared", "DevOpsWitness", "CrossRepoE2E", "MAUI"] },
    "gateEnum": { "const": ["ProtocolPackageBlocking", "CutoverFinalRelease"] },
    "rows": {
      "type": "array",
      "minItems": 314,
      "maxItems": 314,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executableOwner", "reasonApiSeam", "gate"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "executableOwner": { "enum": ["Protocol", "Registry", "XNode", "Shared", "DevOpsWitness", "CrossRepoE2E", "MAUI"] },
        "reasonApiSeam": { "type": "string", "minLength": 32, "maxLength": 256 },
        "gate": { "enum": ["ProtocolPackageBlocking", "CutoverFinalRelease"] }
      }
    }
  }
}
