{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deep:crypto:v1:vectors",
  "title": "Deep crypto v1 vector set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "specRevision", "providers", "recovery", "handshake"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "specRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "providers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recoveryVector" }
    },
    "handshake": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/handshakeVector" }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "recoveryVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "outcome", "entropy", "mnemonic", "networkId", "accountGeneration"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "outcome": { "enum": ["valid", "invalid-before-kdf"] },
        "entropy": { "$ref": "#/$defs/hex32" },
        "mnemonic": { "type": "string", "minLength": 1 },
        "networkId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "accountGeneration": { "type": "string", "pattern": "^[0-9]+$" },
        "bip39Seed": { "$ref": "#/$defs/hex64" },
        "accountSigningSeed": { "$ref": "#/$defs/hex32" },
        "accountPqSigningSeed": { "$ref": "#/$defs/hex32" },
        "recoveryAuthorizationSeed": { "$ref": "#/$defs/hex32" },
        "backupWrappingSeed": { "$ref": "#/$defs/hex32" },
        "failure": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "valid" } } },
          "then": {
            "required": [
              "bip39Seed", "accountSigningSeed", "accountPqSigningSeed",
              "recoveryAuthorizationSeed", "backupWrappingSeed"
            ]
          },
          "else": { "required": ["failure"] }
        }
      ]
    },
    "handshakeVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "suite", "outcome", "prekeyBundle", "initialHeader"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "suite": { "enum": [257, 258] },
        "outcome": { "enum": ["valid", "invalid-before-crypto", "invalid-after-decap"] },
        "prekeyBundle": { "$ref": "#/$defs/hex" },
        "initialHeader": { "$ref": "#/$defs/hex" },
        "transcriptHash": { "$ref": "#/$defs/hex64" },
        "ecRoot": { "$ref": "#/$defs/hex32" },
        "pqRoot": { "$ref": "#/$defs/hex32" },
        "initialAeadKey": { "$ref": "#/$defs/hex32" },
        "failure": { "type": "string", "minLength": 1, "maxLength": 128 },
        "callbacks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signature", "encapsulation", "decapsulation", "mutation"],
          "properties": {
            "signature": { "type": "integer", "minimum": 0 },
            "encapsulation": { "type": "integer", "minimum": 0 },
            "decapsulation": { "type": "integer", "minimum": 0 },
            "mutation": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "valid" } } },
          "then": {
            "required": ["transcriptHash", "ecRoot", "pqRoot", "initialAeadKey", "callbacks"]
          },
          "else": { "required": ["failure", "callbacks"] }
        }
      ]
    }
  }
}
