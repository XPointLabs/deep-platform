{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XPointLabs/deep-platform/blob/main/docs/architecture/release-scope.v1.schema.json",
  "title": "Deep V1 release scenario and evidence contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "normativeSource", "retentionNormativeSource", "releaseVerifierPackage", "releaseGateConsumerRepository", "semanticValidation", "boundaryRules", "measurementProfiles", "scenarios", "retentionScenarios"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "releaseId": { "const": "deep-v1-official-xpoint3" },
    "normativeSource": { "const": "V1-RELEASE-SCOPE.md" },
    "retentionNormativeSource": { "const": "RETENTION-AND-RECOVERY-V1.md" },
    "releaseVerifierPackage": { "const": "E2E-01" },
    "releaseGateConsumerRepository": { "const": "deep-devops" },
    "semanticValidation": { "const": { "exactCatalogs": true, "uniqueIds": true, "referencesMustResolve": true, "scenarioSpecificPredicates": true, "pairProfilesRequireTargetPairs": true, "ownersAreSchemaPinned": true } },
    "boundaryRules": { "$ref": "#/$defs/boundaryCatalog" },
    "measurementProfiles": { "$ref": "#/$defs/profileCatalog" },
    "scenarios": { "$ref": "#/$defs/scenarioCatalog" },
    "retentionScenarios": { "$ref": "#/$defs/retentionCatalog" }
  },
  "$defs": {
    "platform": { "enum": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64", "portable-sqlite", "portable-in-memory", "call-relay", "official-xpoint3-deployment"] },
    "allTargetPairs": { "const": ["android-arm64-phone-a->android-arm64-phone-b", "android-arm64-phone-b->android-arm64-phone-a", "android-arm64-phone-a->windows-x64", "windows-x64->android-arm64-phone-a", "android-arm64-phone-b->windows-arm64", "windows-arm64->android-arm64-phone-b"] },
    "targetPair": { "enum": ["android-arm64-phone-a->android-arm64-phone-b", "android-arm64-phone-b->android-arm64-phone-a", "android-arm64-phone-a->windows-x64", "windows-x64->android-arm64-phone-a", "android-arm64-phone-b->windows-arm64", "windows-arm64->android-arm64-phone-b"] },
    "boundaryId": { "enum": ["TIME-BOUNDARY-V1", "GENERATION-BOUNDARY-V1", "SUPERSESSION-GRACE-V1", "TERMINAL-TOMBSTONE-V1", "INDEFINITE-CHECKPOINT-V1"] },
    "boundaryRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "rule"],
      "properties": { "id": { "$ref": "#/$defs/boundaryId" }, "rule": { "type": "string", "minLength": 1 } }
    },
    "boundaryCatalog": {
      "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/boundaryRule" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "TIME-BOUNDARY-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "GENERATION-BOUNDARY-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "SUPERSESSION-GRACE-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "TERMINAL-TOMBSTONE-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "INDEFINITE-CHECKPOINT-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "profileId": { "enum": ["LATENCY-LAB-V1", "GROUP-LAB-V1", "GROUP-200-BASELINE-LAB-V1", "ATTACHMENT-LAB-V1", "MEDIA-LAB-V1", "ANDROID-IDLE-V1", "SESSION-COMPARISON-V1"] },
    "profileBase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "targetPlatforms", "warmupSamplesPerRun", "measuredSamplesPerRun", "clock", "percentileAlgorithm", "failureTreatment", "outlierPolicy", "networkProfile", "environmentCapture"],
      "properties": {
        "id": { "$ref": "#/$defs/profileId" }, "kind": { "enum": ["latency", "group", "attachment", "media", "idle", "comparison"] },
        "targetPlatforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/platform" } },
        "targetPairs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/targetPair" } },
        "independentRunsPerTargetPair": { "type": "integer", "minimum": 1 }, "independentRunsPerTarget": { "type": "integer", "minimum": 1 },
        "warmupSamplesPerRun": { "type": "integer", "minimum": 0 }, "measuredSamplesPerRun": { "type": "integer", "minimum": 1 },
        "clock": { "type": "string", "minLength": 1 }, "percentileAlgorithm": { "type": "string", "minLength": 1 },
        "failureTreatment": { "type": "string", "minLength": 1 }, "outlierPolicy": { "type": "string", "minLength": 1 },
        "networkProfile": { "type": "string", "minLength": 1 }, "environmentCapture": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "pairProfileShape": { "required": ["targetPairs", "independentRunsPerTargetPair"], "not": { "required": ["independentRunsPerTarget"] } },
    "nonPairProfileShape": { "required": ["independentRunsPerTarget"], "allOf": [{ "not": { "required": ["targetPairs"] } }, { "not": { "required": ["independentRunsPerTargetPair"] } }] },
    "measurementProfile": {
      "allOf": [
        { "$ref": "#/$defs/profileBase" },
        { "oneOf": [
          { "allOf": [{ "$ref": "#/$defs/pairProfileShape" }, { "properties": { "id": { "const": "LATENCY-LAB-V1" }, "kind": { "const": "latency" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"] }, "targetPairs": { "$ref": "#/$defs/allTargetPairs" } } }] },
          { "allOf": [{ "$ref": "#/$defs/nonPairProfileShape" }, { "properties": { "id": { "const": "GROUP-LAB-V1" }, "kind": { "const": "group" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"] } } }] },
          { "allOf": [{ "$ref": "#/$defs/nonPairProfileShape" }, { "properties": { "id": { "const": "GROUP-200-BASELINE-LAB-V1" }, "kind": { "const": "group" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "windows-x64"] } } }] },
          { "allOf": [{ "$ref": "#/$defs/pairProfileShape" }, { "properties": { "id": { "const": "ATTACHMENT-LAB-V1" }, "kind": { "const": "attachment" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"] }, "targetPairs": { "$ref": "#/$defs/allTargetPairs" } } }] },
          { "allOf": [{ "$ref": "#/$defs/pairProfileShape" }, { "properties": { "id": { "const": "MEDIA-LAB-V1" }, "kind": { "const": "media" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"] }, "targetPairs": { "$ref": "#/$defs/allTargetPairs" } } }] },
          { "allOf": [{ "$ref": "#/$defs/nonPairProfileShape" }, { "properties": { "id": { "const": "ANDROID-IDLE-V1" }, "kind": { "const": "idle" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "android-arm64-phone-b"] } } }] },
          { "allOf": [{ "$ref": "#/$defs/pairProfileShape" }, { "properties": { "id": { "const": "SESSION-COMPARISON-V1" }, "kind": { "const": "comparison" }, "targetPlatforms": { "const": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"] }, "targetPairs": { "$ref": "#/$defs/allTargetPairs" } } }] }
        ] }
      ]
    },
    "profileCatalog": {
      "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/measurementProfile" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "LATENCY-LAB-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "GROUP-LAB-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "GROUP-200-BASELINE-LAB-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ATTACHMENT-LAB-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "MEDIA-LAB-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ANDROID-IDLE-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "SESSION-COMPARISON-V1" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "pFunctional": { "type": "object", "additionalProperties": false, "required": ["requiredPairs", "allCasesPass"], "properties": { "requiredPairs": { "$ref": "#/$defs/allTargetPairs" }, "allCasesPass": { "type": "boolean" } } },
    "pGroup100": { "type": "object", "additionalProperties": false, "required": ["members", "activeTargetDevices", "p95FirstRemoteMaterializationMsMax", "p95CompleteAcceptedFanoutMsMax", "wireBytesMax"], "properties": { "members": { "type": "integer", "minimum": 1 }, "activeTargetDevices": { "type": "integer", "minimum": 1 }, "p95FirstRemoteMaterializationMsMax": { "type": "integer", "minimum": 1 }, "p95CompleteAcceptedFanoutMsMax": { "type": "integer", "minimum": 1 }, "wireBytesMax": { "type": "integer", "minimum": 1 } } },
    "pGroup200": { "type": "object", "additionalProperties": false, "required": ["artifactRequired", "thresholdBlocking"], "properties": { "artifactRequired": { "type": "boolean" }, "thresholdBlocking": { "type": "boolean" } } },
    "pOutbox": { "type": "object", "additionalProperties": false, "required": ["deterministicCasesMin", "allAcceptedCorpusEventsMaterializeOnce", "caseGeneratorVersionRecorded", "seedSetRecorded"], "properties": { "deterministicCasesMin": { "type": "integer", "minimum": 1 }, "allAcceptedCorpusEventsMaterializeOnce": { "type": "boolean" }, "caseGeneratorVersionRecorded": { "type": "boolean" }, "seedSetRecorded": { "type": "boolean" } } },
    "pText": { "type": "object", "additionalProperties": false, "required": ["p50MsMax", "p95MsMax", "p99MsMax"], "properties": { "p50MsMax": { "type": "integer", "minimum": 1 }, "p95MsMax": { "type": "integer", "minimum": 1 }, "p99MsMax": { "type": "integer", "minimum": 1 } } },
    "pP95": { "type": "object", "additionalProperties": false, "required": ["p95MsMax"], "properties": { "p95MsMax": { "type": "integer", "minimum": 1 } } },
    "pAttachment": { "type": "object", "additionalProperties": false, "required": ["objectBytes", "medianGoodputRatioMin"], "properties": { "objectBytes": { "type": "integer", "minimum": 1 }, "medianGoodputRatioMin": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } },
    "pCallSetup": { "type": "object", "additionalProperties": false, "required": ["ringP95MsMax", "connectedMediaP95MsMax"], "properties": { "ringP95MsMax": { "type": "integer", "minimum": 1 }, "connectedMediaP95MsMax": { "type": "integer", "minimum": 1 } } },
    "pCallMedia": { "type": "object", "additionalProperties": false, "required": ["sameRegionRttP95MsMax", "rttWarningMs", "tenMinuteRecoveryAudioLossFractionMaxExclusive", "udpBlockedTcpAudioRecoveryP95MsMax"], "properties": { "sameRegionRttP95MsMax": { "type": "integer", "minimum": 1 }, "rttWarningMs": { "type": "integer", "minimum": 1 }, "tenMinuteRecoveryAudioLossFractionMaxExclusive": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "udpBlockedTcpAudioRecoveryP95MsMax": { "type": "integer", "minimum": 1 } } },
    "pIdle": { "type": "object", "additionalProperties": false, "required": ["durationSeconds", "processCpuSecondsMax", "totalWakelockSecondsMax", "singleWakelockSecondsMax", "backgroundWakeupsMax", "networkBytesMax", "batteryPercentagePointDropMax"], "properties": { "durationSeconds": { "type": "integer", "minimum": 1 }, "processCpuSecondsMax": { "type": "number", "minimum": 0 }, "totalWakelockSecondsMax": { "type": "number", "minimum": 0 }, "singleWakelockSecondsMax": { "type": "number", "minimum": 0 }, "backgroundWakeupsMax": { "type": "integer", "minimum": 0 }, "networkBytesMax": { "type": "integer", "minimum": 0 }, "batteryPercentagePointDropMax": { "type": "number", "minimum": 0 } } },
    "pOhttp": { "type": "object", "additionalProperties": false, "required": ["channel", "rfc9458RelayGatewaySplitUsed", "validSignedBundleAccepted", "wrongNetworkRollbackForkRejected"], "properties": { "channel": { "const": "in-app-oblivious" }, "rfc9458RelayGatewaySplitUsed": { "type": "boolean" }, "validSignedBundleAccepted": { "type": "boolean" }, "wrongNetworkRollbackForkRejected": { "type": "boolean" } } },
    "pMulti": { "type": "object", "additionalProperties": false, "required": ["channel", "unrelatedOriginsUsed", "validSignedBundleAccepted", "withholdingAndForkDetected"], "properties": { "channel": { "const": "multi-origin-https" }, "unrelatedOriginsUsed": { "type": "boolean" }, "validSignedBundleAccepted": { "type": "boolean" }, "withholdingAndForkDetected": { "type": "boolean" } } },
    "pImport": { "type": "object", "additionalProperties": false, "required": ["channel", "validSignedBundleAccepted", "tamperWrongNetworkRollbackRejected"], "properties": { "channel": { "const": "user-import" }, "validSignedBundleAccepted": { "type": "boolean" }, "tamperWrongNetworkRollbackRejected": { "type": "boolean" } } },
    "pNminus1": { "type": "object", "additionalProperties": false, "required": ["eachSingleChannelFailureTested", "atLeastOneRemainingAuthorizedPathWorks", "threeChannelsDoNotResolveToOneRequiredOriginOrCredential"], "properties": { "eachSingleChannelFailureTested": { "type": "boolean" }, "atLeastOneRemainingAuthorizedPathWorks": { "type": "boolean" }, "threeChannelsDoNotResolveToOneRequiredOriginOrCredential": { "type": "boolean" } } },
    "pCens": { "type": "object", "additionalProperties": false, "required": ["noDirectFallback", "textContactFileRemainAvailableThroughAnAuthorizedRemainingCarrier", "udpBlockUsesMaskedTcpAudio", "apkAndMsixExtractionTested"], "properties": { "noDirectFallback": { "type": "boolean" }, "textContactFileRemainAvailableThroughAnAuthorizedRemainingCarrier": { "type": "boolean" }, "udpBlockUsesMaskedTcpAudio": { "type": "boolean" }, "apkAndMsixExtractionTested": { "type": "boolean" } } },
    "pOffline": { "type": "object", "additionalProperties": false, "required": ["sameAccountAndDid", "newDeviceKeysOnPhraseRecovery", "noExpiredCiphertextPromise", "rollbackForkWrongNetworkRejected"], "properties": { "sameAccountAndDid": { "type": "boolean" }, "newDeviceKeysOnPhraseRecovery": { "type": "boolean" }, "noExpiredCiphertextPromise": { "type": "boolean" }, "rollbackForkWrongNetworkRejected": { "type": "boolean" } } },
    "pCallPhysical": { "type": "object", "additionalProperties": false, "required": ["noPeerHostCandidate", "noSilentDirectPath", "allCasesPass"], "properties": { "noPeerHostCandidate": { "type": "boolean" }, "noSilentDirectPath": { "type": "boolean" }, "allCasesPass": { "type": "boolean" } } },
    "pRelayDecrypt": { "type": "object", "additionalProperties": false, "required": ["relayHasNoEndpointPrivateKeyOrExportedSrtpKey", "decryptAttemptProducesNoAuthenticatedMedia", "fingerprintsMatchAuthenticatedPeers", "noPlaintextInRelayLogsOrArtifacts"], "properties": { "relayHasNoEndpointPrivateKeyOrExportedSrtpKey": { "type": "boolean" }, "decryptAttemptProducesNoAuthenticatedMedia": { "type": "boolean" }, "fingerprintsMatchAuthenticatedPeers": { "type": "boolean" }, "noPlaintextInRelayLogsOrArtifacts": { "type": "boolean" } } },
    "pPrivacy": { "type": "object", "additionalProperties": false, "required": ["allCasesPass", "unresolvedCriticalOrHighDependencies", "reviewP0", "reviewP1"], "properties": { "allCasesPass": { "type": "boolean" }, "unresolvedCriticalOrHighDependencies": { "type": "integer", "minimum": 0 }, "reviewP0": { "type": "integer", "minimum": 0 }, "reviewP1": { "type": "integer", "minimum": 0 } } },
    "pSession": { "type": "object", "additionalProperties": false, "required": ["regressionFractionRequiringReleaseDecision", "cannotRelaxBlockingAbsoluteGate", "sessionVersionAndHashRequired"], "properties": { "regressionFractionRequiringReleaseDecision": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "cannotRelaxBlockingAbsoluteGate": { "type": "boolean" }, "sessionVersionAndHashRequired": { "type": "boolean" } } },
    "scenarioBase": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarioId", "evidenceId", "title", "blocking", "ownerPackage", "ownerRepository", "releaseVerifierPackage", "evidenceKind", "platforms", "passCriteria"],
      "properties": {
        "scenarioId": { "type": "string" }, "evidenceId": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "blocking": { "type": "boolean" },
        "ownerPackage": { "type": "string" }, "ownerRepository": { "type": "string" }, "releaseVerifierPackage": { "const": "E2E-01" }, "evidenceKind": { "type": "string", "minLength": 1 },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/platform" } },
        "measurementProfileId": { "$ref": "#/$defs/profileId" }, "cases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "passCriteria": { "type": "object" }
      }
    },
    "hasCasesNoProfile": { "required": ["cases"], "not": { "required": ["measurementProfileId"] } },
    "hasProfileNoCases": { "required": ["measurementProfileId"], "not": { "required": ["cases"] } },
    "noCasesNoProfile": { "allOf": [{ "not": { "required": ["measurementProfileId"] } }, { "not": { "required": ["cases"] } }] },
    "scenario": {
      "allOf": [
        { "$ref": "#/$defs/scenarioBase" },
        { "oneOf": [
          { "allOf": [{ "$ref": "#/$defs/hasCasesNoProfile" }, { "properties": { "scenarioId": { "const": "REL-FUNCTIONAL-MATRIX-V1" }, "evidenceId": { "const": "EVD-FUNCTIONAL-MATRIX-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "E2E-01" }, "ownerRepository": { "const": "deep-tests-e2e" }, "passCriteria": { "$ref": "#/$defs/pFunctional" } } }] },
          { "required": ["measurementProfileId", "cases"], "properties": { "scenarioId": { "const": "REL-GROUP-100-V1" }, "evidenceId": { "const": "EVD-GROUP-100-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "GROUP-CLIENT-01" }, "ownerRepository": { "const": "deep-client-shared" }, "measurementProfileId": { "const": "GROUP-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pGroup100" } } },
          { "required": ["measurementProfileId", "cases"], "properties": { "scenarioId": { "const": "REL-GROUP-200-BASELINE-V1" }, "evidenceId": { "const": "EVD-GROUP-200-BASELINE-V1" }, "blocking": { "const": false }, "ownerPackage": { "const": "GROUP-CLIENT-01" }, "ownerRepository": { "const": "deep-client-shared" }, "measurementProfileId": { "const": "GROUP-200-BASELINE-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pGroup200" } } },
          { "allOf": [{ "$ref": "#/$defs/hasCasesNoProfile" }, { "properties": { "scenarioId": { "const": "REL-OUTBOX-FAULTS-V1" }, "evidenceId": { "const": "EVD-OUTBOX-FAULTS-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "MSG-01" }, "ownerRepository": { "const": "deep-client-shared" }, "passCriteria": { "$ref": "#/$defs/pOutbox" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-TEXT-WARM-V1" }, "evidenceId": { "const": "EVD-PERF-TEXT-WARM-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "E2E-01" }, "ownerRepository": { "const": "deep-tests-e2e" }, "measurementProfileId": { "const": "LATENCY-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pText" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-START-COLD-V1" }, "evidenceId": { "const": "EVD-PERF-START-COLD-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "COMPOSE-01" }, "ownerRepository": { "const": "deep-client-maui" }, "measurementProfileId": { "const": "LATENCY-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pP95" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-BOOTSTRAP-FRESH-V1" }, "evidenceId": { "const": "EVD-PERF-BOOTSTRAP-FRESH-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "BRIDGE-01" }, "ownerRepository": { "const": "deep-devops" }, "measurementProfileId": { "const": "LATENCY-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pP95" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-ATTACHMENT-10M-V1" }, "evidenceId": { "const": "EVD-PERF-ATTACHMENT-10M-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "BLOB-01" }, "ownerRepository": { "const": "deep-client-shared" }, "measurementProfileId": { "const": "ATTACHMENT-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pAttachment" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-CALL-SETUP-V1" }, "evidenceId": { "const": "EVD-PERF-CALL-SETUP-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "CALL-MEDIA-01" }, "ownerRepository": { "const": "deep-client-maui" }, "measurementProfileId": { "const": "MEDIA-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pCallSetup" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-CALL-MEDIA-V1" }, "evidenceId": { "const": "EVD-PERF-CALL-MEDIA-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "CALL-MEDIA-01" }, "ownerRepository": { "const": "deep-client-maui" }, "measurementProfileId": { "const": "MEDIA-LAB-V1" }, "passCriteria": { "$ref": "#/$defs/pCallMedia" } } }] },
          { "allOf": [{ "$ref": "#/$defs/hasProfileNoCases" }, { "properties": { "scenarioId": { "const": "PERF-ANDROID-IDLE-V1" }, "evidenceId": { "const": "EVD-PERF-ANDROID-IDLE-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "COMPOSE-01" }, "ownerRepository": { "const": "deep-client-maui" }, "measurementProfileId": { "const": "ANDROID-IDLE-V1" }, "passCriteria": { "$ref": "#/$defs/pIdle" } } }] },
          { "allOf": [{ "$ref": "#/$defs/noCasesNoProfile" }, { "properties": { "scenarioId": { "const": "CENS-ACQ-OHTTP-V1" }, "evidenceId": { "const": "EVD-CENS-ACQ-OHTTP-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "BRIDGE-01" }, "ownerRepository": { "const": "deep-devops" }, "passCriteria": { "$ref": "#/$defs/pOhttp" } } }] },
          { "allOf": [{ "$ref": "#/$defs/noCasesNoProfile" }, { "properties": { "scenarioId": { "const": "CENS-ACQ-MULTI-ORIGIN-V1" }, "evidenceId": { "const": "EVD-CENS-ACQ-MULTI-ORIGIN-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "BRIDGE-01" }, "ownerRepository": { "const": "deep-devops" }, "passCriteria": { "$ref": "#/$defs/pMulti" } } }] },
          { "allOf": [{ "$ref": "#/$defs/noCasesNoProfile" }, { "properties": { "scenarioId": { "const": "CENS-ACQ-USER-IMPORT-V1" }, "evidenceId": { "const": "EVD-CENS-ACQ-USER-IMPORT-V1" }, "blocking": { "const": true }, "ownerPackage": { "const": "BRIDGE-01" }, "ownerRepository": { "const": "deep-devops" }, "passCriteria": { "$ref": "#/$defs/pImport" } } }] },
