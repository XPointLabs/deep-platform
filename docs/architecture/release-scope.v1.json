  "releaseVerifierPackage": "E2E-01",
  "releaseGateConsumerRepository": "deep-devops",
  "semanticValidation": {
    "exactCatalogs": true,
    "uniqueIds": true,
    "referencesMustResolve": true,
    "scenarioSpecificPredicates": true,
    "pairProfilesRequireTargetPairs": true,
    "ownersAreSchemaPinned": true
  },
  "boundaryRules": [
    {
      "id": "TIME-BOUNDARY-V1",
      "rule": "For every finite duration T, exercise signed time at T-1 second, T, and T+1 second; local wall clock cannot extend validity."
    },
    {
      "id": "GENERATION-BOUNDARY-V1",
      "rule": "For every retained generation or commit floor N, exercise N-1, N, and N+1 objects plus restart during compaction; when time and generation are joined by 'and at least', neither condition alone permits deletion."
    },
    {
      "id": "SUPERSESSION-GRACE-V1",
      "rule": "Exercise predecessor/current/successor visibility immediately before, at, and after the declared supersession or replay grace, including replica repair and cold restart."
    },
    {
      "id": "TERMINAL-TOMBSTONE-V1",
      "rule": "At terminal success, cancel, or expiry, prove payload and keys are deleted at their deadline while the metadata-only tombstone remains until its separate deadline, then is deleted at boundary+1."
    },
    {
      "id": "INDEFINITE-CHECKPOINT-V1",
      "rule": "After the finite operational horizon, prove a root-authorized checkpoint or re-enrollment restores current trust without interpreting missing ciphertext/history as an empty successful synchronization."
    }
  ],
  "measurementProfiles": [
    {
      "id": "LATENCY-LAB-V1",
      "kind": "latency",
      "targetPlatforms": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"],
      "targetPairs": ["android-arm64-phone-a->android-arm64-phone-b", "android-arm64-phone-b->android-arm64-phone-a", "android-arm64-phone-a->windows-x64", "windows-x64->android-arm64-phone-a", "android-arm64-phone-b->windows-arm64", "windows-arm64->android-arm64-phone-b"],
      "independentRunsPerTargetPair": 3,
      "warmupSamplesPerRun": 20,
      "measuredSamplesPerRun": 200,
      "clock": "monotonic endpoint clocks calibrated before each run; sender-to-recipient metrics use a shared monotonic test-controller clock",
      "percentileAlgorithm": "nearest-rank over the concatenated measured samples for each required target/pair; pXX rank is ceil(XX/100*N)",
      "failureTreatment": "timeout, terminal failure, or missing materialization is positive infinity and remains in the percentile population",
      "outlierPolicy": "no outlier removal; invalid harness runs are discarded only with a machine-readable harness-failure code before result inspection",
      "networkProfile": "50 ms client-to-entry RTT, 25 ms each inter-node RTT, 1% independent packet loss, 20 Mbps down, 5 Mbps up",
      "environmentCapture": "signed evidence maps every target alias to manufacturer/model, CPU or SoC, RAM, OS build, power mode, app hash, server hashes, node regions, shaper configuration and UTC run window",
      "preconditions": ["production-bound signed commit matrix", "warm bootstrap except the explicitly cold/fresh scenario", "sanitized raw samples retained"]
    },
    {
      "id": "GROUP-LAB-V1",
      "kind": "group",
      "targetPlatforms": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"],
      "independentRunsPerTarget": 3,
      "warmupSamplesPerRun": 5,
      "measuredSamplesPerRun": 40,
      "clock": "shared monotonic test-controller clock",
      "percentileAlgorithm": "nearest-rank over all measured logical group batches for each target topology",
      "failureTreatment": "an unaccepted target or missing materialization is positive infinity; bytes include every carrier/onion/application byte for the logical batch",
      "outlierPolicy": "no outlier removal",
      "networkProfile": "same shaped network as LATENCY-LAB-V1 with 5 Mbps sender uplink",
      "environmentCapture": "signed evidence maps every target alias and deterministic protocol-client host to hardware, OS/runtime build, app/server hashes, node regions, shaper configuration and UTC run window",
      "preconditions": ["500 active target devices represented by deterministic real-protocol clients", "at least Android A, Android B, and Windows participate as physical endpoints"]
    },
    {
      "id": "GROUP-200-BASELINE-LAB-V1",
      "kind": "group",
      "targetPlatforms": ["android-arm64-phone-a", "windows-x64"],
      "independentRunsPerTarget": 3,
      "warmupSamplesPerRun": 2,
      "measuredSamplesPerRun": 20,
      "clock": "shared monotonic test-controller clock",
      "percentileAlgorithm": "nearest-rank over measured logical 200-member batches; report only because this profile is non-blocking",
      "failureTreatment": "failed or incomplete batches remain in raw samples and the artifact; no release threshold is inferred",
      "outlierPolicy": "no outlier removal",
      "networkProfile": "same shaped network as GROUP-LAB-V1 with 5 Mbps sender uplink",
      "environmentCapture": "signed evidence records physical endpoints, deterministic protocol-client hosts, app/server hashes, shaper configuration and UTC run window",
      "preconditions": ["200 one-device members", "one owner-sequenced event", "artifact is non-blocking and does not expand V1 support"]
    },
    {
      "id": "ATTACHMENT-LAB-V1",
      "kind": "attachment",
      "targetPlatforms": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"],
      "targetPairs": ["android-arm64-phone-a->android-arm64-phone-b", "android-arm64-phone-b->android-arm64-phone-a", "android-arm64-phone-a->windows-x64", "windows-x64->android-arm64-phone-a", "android-arm64-phone-b->windows-arm64", "windows-arm64->android-arm64-phone-b"],
      "independentRunsPerTargetPair": 3,
      "warmupSamplesPerRun": 1,
      "measuredSamplesPerRun": 10,
      "clock": "shared monotonic test-controller clock",
      "percentileAlgorithm": "ratio is computed per run; gate uses the minimum median ratio across required target pairs",
      "failureTreatment": "integrity failure, restart failure, or incomplete transfer is ratio zero",
      "outlierPolicy": "no outlier removal",
      "networkProfile": "masked and direct CA-valid HTTPS runs use the same shaped network and object bytes",
      "environmentCapture": "signed evidence maps target aliases to hardware and OS builds and records app/server hashes, exact object hash, shaper configuration, carrier, comparator endpoint and UTC run window",
      "preconditions": ["direct baseline is a lab comparator only and is absent from release composition"]
    },
    {
      "id": "MEDIA-LAB-V1",
      "kind": "media",
      "targetPlatforms": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"],
      "targetPairs": ["android-arm64-phone-a->android-arm64-phone-b", "android-arm64-phone-b->android-arm64-phone-a", "android-arm64-phone-a->windows-x64", "windows-x64->android-arm64-phone-a", "android-arm64-phone-b->windows-arm64", "windows-arm64->android-arm64-phone-b"],
      "independentRunsPerTargetPair": 3,
      "warmupSamplesPerRun": 5,
      "measuredSamplesPerRun": 100,
      "clock": "shared monotonic test-controller clock plus WebRTC monotonic stats timestamps",
      "percentileAlgorithm": "nearest-rank per required call pair; ten-minute loss is computed from authenticated WebRTC packet counters without excluding recovery intervals",
      "failureTreatment": "failed ring/connect/recovery is positive infinity; missing media is 100 percent loss",
      "outlierPolicy": "no outlier removal",
      "networkProfile": "LATENCY-LAB-V1 profile plus explicit UDP-blocked variant",
      "environmentCapture": "signed evidence maps target aliases to hardware, radio/network interface and OS/WebRTC builds and records app/relay hashes, relay region, shaper configuration and UTC run window",
      "preconditions": ["relay-only candidates", "selected pair and carrier profile captured without credentials"]
    },
    {
      "id": "ANDROID-IDLE-V1",
      "kind": "idle",
      "targetPlatforms": ["android-arm64-phone-a", "android-arm64-phone-b"],
      "independentRunsPerTarget": 3,
      "warmupSamplesPerRun": 0,
      "measuredSamplesPerRun": 1,
      "clock": "device monotonic clock for a 15-minute screen-off background interval",
      "percentileAlgorithm": "every run must satisfy every absolute budget",
      "failureTreatment": "missing OS counters or harness interruption fails the run",
      "outlierPolicy": "no outlier removal",
      "networkProfile": "network available, warm bootstrap, no incoming user traffic or push",
      "environmentCapture": "signed evidence maps each phone alias to manufacturer/model, SoC, RAM, Android build and battery health and records app hash, radio type, OS counter source, thermal state and UTC run window",
      "preconditions": ["battery at least 50 percent", "device not charging", "thermal state nominal", "same production-bound build"]
    },
    {
      "id": "SESSION-COMPARISON-V1",
      "kind": "comparison",
      "targetPlatforms": ["android-arm64-phone-a", "android-arm64-phone-b", "windows-x64", "windows-arm64"],
      "targetPairs": ["android-arm64-phone-a->android-arm64-phone-b", "android-arm64-phone-b->android-arm64-phone-a", "android-arm64-phone-a->windows-x64", "windows-x64->android-arm64-phone-a", "android-arm64-phone-b->windows-arm64", "windows-arm64->android-arm64-phone-b"],
      "independentRunsPerTargetPair": 2,
      "warmupSamplesPerRun": 10,
      "measuredSamplesPerRun": 50,
      "clock": "same monotonic controller and endpoint definitions for Deep and the pinned stable Session build",
      "percentileAlgorithm": "compare matching nearest-rank warm-text and call-setup percentiles per access network",
      "failureTreatment": "failure remains positive infinity and is not replaced by a successful retry",
      "outlierPolicy": "no outlier removal",
      "networkProfile": "the same two recorded real access networks, devices, time window, and relay region for both applications",
      "environmentCapture": "signed evidence records identical target hardware/OS, access-network identity class, relay region and UTC comparison window plus Deep and Session version, build hash and configuration",
      "preconditions": ["Session version/hash recorded", "comparison is observational and cannot relax an absolute Deep gate"]
    }
